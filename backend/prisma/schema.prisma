// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // app runtime → pooled (PgBouncer)
  directUrl = env("DIRECT_URL")     // prisma migrate → direktno na Postgres
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)
  categories   Category[]
  transactions Transaction[]
}

enum Role {
  user
  admin
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String
  type   TxType
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([userId, name])   // ← NOVO: jedan user ne može imati dve "Food"
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Postgres NE indeksira foreign key sam. Glavni upit aplikacije je
  // WHERE "userId" = ? ORDER BY "date" DESC LIMIT n (lista transakcija).
  // Jednakost (userId) prva, sort/opseg (date) drugi → redovi jednog korisnika su
  // uzastopni, već sortiran blok u indeksu. Levi prefiks pokriva i upite samo
  // po userId (count, /stats groupBy).
  // Izmereno (Dan 11, 11k redova, korisnik sa 505):
  //   lista: Seq Scan + Sort, 104 stranice, 1.56 ms → Index Scan Backward, 17, 0.07 ms
  //   count: Seq Scan, 104 stranice, 1.78 ms       → Index Only Scan, 6, 0.37 ms
  @@index([userId, date])
}

enum TxType {
  income
  expense
}
